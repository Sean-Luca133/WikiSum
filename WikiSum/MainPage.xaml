<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WikiSum.MainPage"
             xmlns:viewModel="clr-namespace:WikiSum.ViewModels"
             x:DataType="viewModel:IMainViewModel"
             Title="MainPage">
    <VerticalStackLayout>
        <Label 
            Text="Welcome to .NET MAUI!"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Button Command="{Binding SearchCommand}"></Button>
        <Label Text="{Binding TestText}"/>
        <Button Text="Translation Test" Command="{Binding TranslateTestCommand}"/>
        <Button Text="Summarize Test" Command="{Binding SummarizeTestcommand}"/>

    </VerticalStackLayout>
</ContentPage>