<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:WikiSum.ViewModels"
    x:Class="WikiSum.Views.EntityPopup"
    x:DataType="viewModels:EntityPopupViewModel"
    HorizontalOptions="Center"
    VerticalOptions="Center">



    <VerticalStackLayout  HeightRequest="200" WidthRequest="200" Spacing="20">

        <!-- Title -->
        <Label
                Text="Entity Details"
                FontSize="22"
                FontAttributes="Bold"
                TextColor="#1F2937"
                HorizontalOptions="Center" />

        <!-- Category -->
        <Border
                BackgroundColor="{AppThemeBinding Light=#DBEAFE, Dark=#1E293B}"
                StrokeThickness="0"
                Padding="10,5"
                StrokeShape="RoundRectangle 20"
                HorizontalOptions="Start">

            <Label
                FormattedText="{Binding Category}"
                TextColor="{AppThemeBinding Light=#2563EB, Dark=#60A5FA}"
                FontAttributes="Bold" />

        </Border>

        <!-- Description -->
        <Label
                FormattedText="{Binding TextValue}"
                FontSize="16"
                TextColor="#4B5563"
                LineBreakMode="WordWrap"/>

        <!-- Close button -->
        <Button
                Text="Close"
                Command="{Binding CancelCommand}"
                BackgroundColor="#2563EB"
                TextColor="White"
                CornerRadius="10"
                Padding="15,10"
                HorizontalOptions="Fill"/>

    </VerticalStackLayout>

</ContentView>