<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModel="clr-namespace:WikiSum.ViewModels"
    xmlns:models="clr-namespace:WikiSum.Models"
    x:Class="WikiSum.Views.WebsiteSummaryPage"
    x:DataType="viewModel:IWebsiteSummaryViewModel">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="20">

            <!-- Header -->
            <Grid ColumnDefinitions="Auto,*">

                <Button
                    Grid.Column="0"
                    ImageSource="terug.png"
                    WidthRequest="45"
                    HeightRequest="45"
                    CornerRadius="22"
                    BackgroundColor="{AppThemeBinding Light='#F8FAFC', Dark='#0F172A'}"
                    BorderColor="{AppThemeBinding Light='#CBD5E1', Dark='#334155'}"
                    Command="{Binding NavigateBackCommand}" />

                <Label
                    Grid.Column="1"
                    Text="Previous Article"
                    FontSize="28"
                    FontAttributes="Bold"
                    VerticalOptions="Center"
                    Margin="15,0,0,0"/>
            </Grid>

            <!-- Description -->
            <Label
                Text="Browse summaries from previously viewed articles."
                FontSize="15"
                TextColor="Gray" />

            <!-- Language Card -->
            <Border
                Padding="15"
                StrokeShape="RoundRectangle 10"
                BackgroundColor="{AppThemeBinding Light='#F8FAFC', Dark='#0F172A'}"
                Stroke="{AppThemeBinding Light='#CBD5E1', Dark='#334155'}">

                <VerticalStackLayout Spacing="8">

                    <Label
                        Text="Language"
                        FontAttributes="Bold"
                        FontSize="16"/>

                    <Picker
                        Title="Select language"
                        ItemsSource="{Binding LanguageOptions}"
                        SelectedIndex="{Binding SelectedLanguage}" />

                </VerticalStackLayout>

            </Border>

            <!-- Paragraphs -->
            <CollectionView ItemsSource="{Binding Paragraphs}">

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:WebsiteParagraph">

                        <Border Stroke="{AppThemeBinding Light='#CBD5E1', Dark='#334155'}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                BackgroundColor="{AppThemeBinding Light='#F8FAFC', Dark='#0F172A'}"
                Padding="15"
                Margin="0,5">

                            <VerticalStackLayout Spacing="12">

                                <!-- Title -->
                                <Label Text="{Binding Header}"
                       FontSize="19"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light='#1E1B4B', Dark='#E0E7FF'}"/>

                                <!-- Important Words Button -->
                                <Button Text="✦  View Important Words"
                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SeeDetailCommand}"
                        CommandParameter="{Binding .}"
                        FontSize="13"
                        TextColor="#4F46E5"
                        BackgroundColor="{AppThemeBinding Light='#EEF2FF', Dark='#312E81'}"
                        CornerRadius="8"
                        HeightRequest="38"
                        HorizontalOptions="Start"
                        Padding="12,0"/>

                                <!-- Divider -->
                                <BoxView HeightRequest="1"
                         Color="{AppThemeBinding Light='#E2E8F0', Dark='#334155'}"/>

                                <!-- Summary -->
                                <Label Text="{Binding ParagraphSummary}"
                       FontSize="15"
                       LineHeight="1.4"
                       TextColor="{AppThemeBinding Light='#475569', Dark='#CBD5E1'}"/>

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>