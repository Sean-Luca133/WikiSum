<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WikiSum.Views.MainPage"
             xmlns:viewModel="clr-namespace:WikiSum.ViewModels"
             xmlns:website_models="clr-namespace:WikiSum.Models.Api.Website"
             x:DataType="viewModel:IMainViewModel"
             Title="WikiSum">


    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="16">

            <!-- Header Sectie -->
            <Label Text="Welcome to WikiSum"
                   FontSize="26"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light='#1E1B4B', Dark='#E0E7FF'}" />

            <Image Source="wikisum_logo.png"
                   SemanticProperties.Description="WikiSum logo"
                   Aspect="AspectFit"
                   HeightRequest="180"
                   MaximumHeightRequest="220"
                   HorizontalOptions="Center" />

            <Label FontSize="15"
                   MaximumWidthRequest="650"
                   HorizontalTextAlignment="Center"
                   HorizontalOptions="Center"
                   Text="This is WikiSum a tool created to make viewing Wikipages easier. Just give the url of the page you need in the desired available language and you are good to go.  Find more details per paragraf afterwards to help you focus and if you need quick a view of a recently viewed page check below."
                   TextColor="{AppThemeBinding Light='#4B5563', Dark='#9CA3AF'}" />

            <Label FontSize="15"
                   MaximumWidthRequest="650"
                   HorizontalTextAlignment="Center"
                   HorizontalOptions="Center"
                   FontAttributes="Italic"
                   TextColor="{AppThemeBinding Light='#4F46E5', Dark='#818CF8'}"
                   Text="{Binding Status}" />

            <!-- Subtiele divider met unieke accentkleur -->
            <BoxView HeightRequest="1" 
                     Color="{AppThemeBinding Light='#E2E8F0', Dark='#334155'}" 
                     Margin="0,8,0,0" />

            <!-- Website Collectie (Mobile First Card Design) -->
            <CollectionView ItemsSource="{Binding Websites}"
                            ItemSizingStrategy="MeasureAllItems">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="website_models:WebsiteRequest">

                        <!-- Kaart container met een warme, moderne border en achtergrond -->
                        <Border Stroke="{AppThemeBinding Light='#CBD5E1', Dark='#334155'}"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{AppThemeBinding Light='#F8FAFC', Dark='#0F172A'}"
                                Padding="14"
                                Margin="0,6">

                            <Grid RowDefinitions="Auto, Auto" 
                                  ColumnDefinitions="*, Auto"
                                  RowSpacing="12" 
                                  ColumnSpacing="10">

                                <!-- Tekst / Info (Links bovenaan) -->
                                <VerticalStackLayout Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Spacing="3">
                                    <Label Text="{Binding Url}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light='#0F172A', Dark='#F8FAFC'}"
                                           LineBreakMode="TailTruncation" />

                                    <Label Text="{Binding LanguagesText}"
                                           FontSize="13"
                                           TextColor="{AppThemeBinding Light='#64748B', Dark='#94A3B8'}" />
                                </VerticalStackLayout>

                                <!-- Actie Knoppen (Unieke Indigo & Soft Coral styling) -->
                                <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" 
                                                       Spacing="10" 
                                                       HorizontalOptions="FillAndExpand">

                                    <Button Text="View Summary" 
                                            FontSize="13"
                                            TextColor="White" 
                                            BackgroundColor="#4F46E5" 
                                            CornerRadius="8"
                                            HeightRequest="38"
                                            Padding="12,0"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SeeSummaryCommand}"
                                            CommandParameter="{Binding .}" />

                                    <Button Text="Delete"
                                            FontSize="13"
                                            BackgroundColor="#F43F5E"
                                            TextColor="White"
                                            CornerRadius="8"
                                            HeightRequest="38"
                                            Padding="12,0"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteWebsiteCommand}"
                                            CommandParameter="{Binding .}" />

                                </HorizontalStackLayout>

                            </Grid>
                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>