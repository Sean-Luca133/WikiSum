<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModel="clr-namespace:WikiSum.ViewModels"
    xmlns:models="clr-namespace:WikiSum.Models"
    x:Class="WikiSum.Views.SummaryDetailPage"
    x:DataType="viewModel:ISummaryDetailViewModel"
    >

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="20">

            <!-- Header -->
            <Grid ColumnDefinitions="Auto,*">

                <Button
                    Grid.Column="0"
                    ImageSource="terug.png"
                    WidthRequest="45"
                    HeightRequest="45"
                    CornerRadius="22"
                    BackgroundColor="{AppThemeBinding Light='#F8FAFC', Dark='#0F172A'}"
                    BorderColor="{AppThemeBinding Light='#CBD5E1', Dark='#334155'}"
                    Command="{Binding NavigateBackCommand}" />

                <Label
                    Grid.Column="1"
                    Text="Important Elements"
                    FontSize="28"
                    FontAttributes="Bold"
                    VerticalOptions="Center"
                    Margin="15,0,0,0"/>
            </Grid>

            <!-- Subtitle -->
            <Label
                Text="Key concepts and important words from this paragraph."
                FontSize="15"
                TextColor="Gray"/>

            <!-- Content Card -->
            <Border
                Margin="0,10"
                Padding="25"
                BackgroundColor="{AppThemeBinding Light='#F8FAFC', Dark='#0F172A'}"
                Stroke="{AppThemeBinding Light='#CBD5E1', Dark='#334155'}"
                StrokeShape="RoundRectangle 12">

                <VerticalStackLayout Spacing="15">

                    <Label
                        Text="Analysis"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="#1F2937"/>

                    <Label
                        FormattedText="{Binding AnalyzedParagraph}"
                        FontSize="16"
                        LineBreakMode="WordWrap"
                        TextColor="#4B5563"/>

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>