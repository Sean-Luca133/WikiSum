<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WikiSum.Views.SummaryPage"
             xmlns:viewModel="clr-namespace:WikiSum.ViewModels"
             xmlns:models="clr-namespace:WikiSum.Models"
             x:DataType="viewModel:ISummaryViewModel"
             Title="SummaryPage">
    <ScrollView Margin="20">
        <VerticalStackLayout HorizontalOptions="Center">
        <Label 
            Text="Select your page to Summarize"
           FontSize="24"
           FontAttributes="Bold"
           VerticalOptions="Center" 
           HorizontalOptions="Center" />
           <HorizontalStackLayout HorizontalOptions="Center" Margin="0,20,0,20" Spacing="15">
            <Label Text="Wiki Url" 
                   FontSize="16"
                   FontAttributes="Bold" 
                   VerticalOptions="Center"
                   />
        <Entry Text="{Binding UrlInput}" 
               MinimumWidthRequest="250"
               Placeholder="https://"/>

                <Picker Title="Language" MinimumWidthRequest="200" ItemsSource="{Binding LanguageOptions}"  SelectedIndex="{Binding SelectedPageLanguage}">
                <Picker.Items >
                   
                </Picker.Items>
            </Picker>

            <Button Command="{Binding SearchCommand}" Text="Search"/>
        </HorizontalStackLayout>
            <Label Text="{Binding FeedbackMessage}" TextColor="Red" FontSize="12"/>


            <CollectionView ItemsSource="{Binding Content}" >
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:WebsiteParagraph">
                        <VerticalStackLayout>
                            <Label HorizontalOptions="Center" Text="{Binding Header }" FontAttributes="Bold" FontSize="30" />
                            <HorizontalStackLayout HorizontalOptions="Center">
                                <Label Text="{Binding ParagraphSummary}" 
                                   MaximumWidthRequest="750"  
                                   
                                   Margin="0,10,0,20"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>