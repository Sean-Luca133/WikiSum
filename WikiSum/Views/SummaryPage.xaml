<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WikiSum.Views.SummaryPage"
             xmlns:viewModel="clr-namespace:WikiSum.ViewModels"
             xmlns:models="clr-namespace:WikiSum.Models"
             x:DataType="viewModel:ISummaryViewModel"
             Title="SummaryPage">

    <CollectionView ItemsSource="{Binding Content}"
                    ItemSizingStrategy="MeasureAllItems"
                    SelectionMode="None">

        <CollectionView.Header>
            <VerticalStackLayout Spacing="20" Padding="16">

                <!-- Header -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Summarize a Page"
                           FontSize="26"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light='#1E1B4B', Dark='#E0E7FF'}"/>

                    <Label Text="Turn any Wikipedia article into a clear and concise summary."
                           FontSize="14"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light='#64748B', Dark='#94A3B8'}"/>
                </VerticalStackLayout>

                <!-- Input Card -->
                <Border Stroke="{AppThemeBinding Light='#CBD5E1', Dark='#334155'}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="{AppThemeBinding Light='#F8FAFC', Dark='#0F172A'}"
                        Padding="16">

                    <VerticalStackLayout Spacing="16">

                        <Label Text="Page Settings"
                               FontSize="19"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light='#0F172A', Dark='#F8FAFC'}"/>

                        <!-- URL -->
                        <VerticalStackLayout Spacing="7">
                            <Label Text="Wikipedia URL"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light='#334155', Dark='#CBD5E1'}"/>


                            <Entry Text="{Binding UrlInput}"
                                       Placeholder="https://en.wikipedia.org/wiki/..."
                                       Keyboard="Url"
                                       ClearButtonVisibility="WhileEditing"
                                       BackgroundColor="Transparent"
                                       TextColor="{AppThemeBinding Light='#0F172A', Dark='#F8FAFC'}"
                                       PlaceholderColor="#94A3B8"/>

                        </VerticalStackLayout>

                        <!-- Language -->
                        <VerticalStackLayout Spacing="7">
                            <Label Text="Summary Language"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light='#334155', Dark='#CBD5E1'}"/>


                            <Picker Title="Choose a language"
                                        ItemsSource="{Binding LanguageOptions}"
                                        SelectedIndex="{Binding SelectedPageLanguage}"
                                        TextColor="{AppThemeBinding Light='#0F172A', Dark='#F8FAFC'}"
                                        BackgroundColor="Transparent"/>

                        </VerticalStackLayout>

                        <!-- Action -->
                        <Button Text="Generate Summary"
                                Command="{Binding SearchCommand}"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="White"
                                BackgroundColor="#4F46E5"
                                CornerRadius="10"
                                HeightRequest="48"
                                HorizontalOptions="Fill"/>

                    </VerticalStackLayout>
                </Border>

                <!-- Error Message -->
                <Border Stroke="#F43F5E"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="{AppThemeBinding Light='#FFF1F2', Dark='#4C0519'}"
                        Padding="14"
                        IsVisible="{Binding IsError}">

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Something went wrong"
                               FontAttributes="Bold"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light='#BE123C', Dark='#FDA4AF'}"/>

                        <Label Text="{Binding FeedbackMessage}"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light='#9F1239', Dark='#FECDD3'}"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Processing Message -->
                <Border Stroke="#F59E0B"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="{AppThemeBinding Light='#FFFBEB', Dark='#451A03'}"
                        Padding="14"
                        IsVisible="{Binding IsProcessing}">

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Processing..."
                               FontAttributes="Bold"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light='#B45309', Dark='#FCD34D'}"/>

                        <Label Text="{Binding ActionMessage}"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light='#92400E', Dark='#FDE68A'}"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Results Header -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="Your Summary"
                           FontSize="23"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light='#1E1B4B', Dark='#E0E7FF'}"/>

                    <BoxView HeightRequest="1"
                             Color="{AppThemeBinding Light='#E2E8F0', Dark='#334155'}"/>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </CollectionView.Header>

        <!-- Summary Items -->
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:WebsiteParagraph">

                <Border Stroke="{AppThemeBinding Light='#CBD5E1', Dark='#334155'}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="{AppThemeBinding Light='#F8FAFC', Dark='#0F172A'}"
                        Padding="15"
                        Margin="16,5">

                    <VerticalStackLayout Spacing="12">

                        <!-- Title -->
                        <Label Text="{Binding Header}"
                               FontSize="19"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light='#1E1B4B', Dark='#E0E7FF'}"/>

                        <!-- Important Words Button -->
                        <Button Text="✦  View Important Words"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SeeDetailCommand}"
                                CommandParameter="{Binding .}"
                                FontSize="13"
                                TextColor="#4F46E5"
                                BackgroundColor="{AppThemeBinding Light='#EEF2FF', Dark='#312E81'}"
                                CornerRadius="8"
                                HeightRequest="38"
                                HorizontalOptions="Start"
                                Padding="12,0"/>

                        <!-- Divider -->
                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light='#E2E8F0', Dark='#334155'}"/>

                        <!-- Summary -->
                        <Label Text="{Binding ParagraphSummary}"
                               FontSize="15"
                               LineHeight="1.4"
                               TextColor="{AppThemeBinding Light='#475569', Dark='#CBD5E1'}"/>

                    </VerticalStackLayout>

                </Border>

            </DataTemplate>
        </CollectionView.ItemTemplate>

        <CollectionView.Footer>
            <BoxView HeightRequest="20" Color="Transparent"/>
        </CollectionView.Footer>
    </CollectionView>
</ContentPage>