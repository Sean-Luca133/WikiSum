<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WikiSum.Views.SummaryPage"
             xmlns:viewModel="clr-namespace:WikiSum.ViewModels"
             xmlns:models="clr-namespace:WikiSum.Models"
             x:DataType="viewModel:ISummaryViewModel"
             Title="SummaryPage">
    <ScrollView Margin="20">
    <VerticalStackLayout>
        <Label 
            Text="Select your page to Summarize"
           FontSize="24"
           FontAttributes="Bold"
           VerticalOptions="Center" 
           HorizontalOptions="Center" />
        <HorizontalStackLayout HorizontalOptions="Center" Margin="0,20,0,0" Spacing="15">
            <Label Text="Wiki Url" 
                   FontSize="16"
                   FontAttributes="Bold" 
                   VerticalOptions="Center"
                   />
        <Entry Text="" 
               MinimumWidthRequest="250"
               Placeholder="https://"/>

            <Picker Title="Language" MinimumWidthRequest="200">
                <Picker.Items>
                    <x:String>English</x:String>
                    <x:String>Dutch</x:String>
                    <x:String>French</x:String>
                </Picker.Items>
            </Picker>

            <Button Command="{Binding SearchCommand}" Text="Search"/>
        </HorizontalStackLayout>


            <CollectionView Grid.Row="1" ItemsSource="{Binding Content}" >
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:WebsiteParagraph">
                        <Grid RowDefinitions="auto, auto, *" ColumnDefinitions="Auto, *" Margin="20,0,20,0" >
                            <Label Grid.ColumnSpan="2" Text="{Binding Header }" FontSize="30" />
                            <HorizontalStackLayout Grid.Row="1" Grid.ColumnSpan="2">
                                <Label Text="{Binding ParagraphSummary}" 
                                   MaximumWidthRequest="550" 
                                   VerticalOptions="Center" 
                                   HorizontalOptions="Center" 
                                   Margin="0,20,0,20"/>
                            </HorizontalStackLayout>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>